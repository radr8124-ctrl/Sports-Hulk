[Unit]
Description=Sports HULK Commercial Preview Tunnel
After=network-online.target sports-hulk-commercial.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/ubuntu/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8510
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
